#!/usr/bin/env bash
set -euo pipefail

repo="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
bin_dir="${XDG_BIN_HOME:-$HOME/.local/bin}"
unit_dir="${XDG_CONFIG_HOME:-$HOME/.config}/systemd/user"
udev_rule="/etc/udev/rules.d/70-streamdeck-ctl.rules"
prompter_rule="/etc/udev/rules.d/72-prompter-ctl.rules"
deck_config="${XDG_CONFIG_HOME:-$HOME/.config}/streamdeck-ctl/config.toml"
with_preset=1
with_skill=0

first_install=0
[ -f "$deck_config" ] || first_install=1

for arg in "$@"; do
    case "$arg" in
        --no-preset) with_preset=0 ;;
        --with-skill) with_skill=1 ;;
        --no-skill) ;;
        -h|--help)
            echo "Usage: scripts/install [--no-preset] [--with-skill]"
            exit 0
            ;;
    esac
done

cargo build --release --manifest-path "$repo/Cargo.toml"

mkdir -p "$bin_dir" "$unit_dir"
for tool in camctl elgatoctl elgato-panel; do
    if [ -L "$bin_dir/$tool" ]; then
        rm -f "$bin_dir/$tool"
        echo "  bin    removed obsolete $tool link"
    fi
done
for tool in camlink-ctl keylight-ctl omgato-panel prompter-ctl streamdeck-ctl; do
    ln -sfn "$repo/target/release/$tool" "$bin_dir/$tool"
    echo "  bin    $bin_dir/$tool"
done

for unit in "$repo"/src/streamdeck-ctl/systemd/*.service "$repo"/src/prompter-ctl/systemd/*.service; do
    install -m 0644 "$unit" "$unit_dir/$(basename "$unit")"
    echo "  unit   $unit_dir/$(basename "$unit")"
done
systemctl --user daemon-reload 2>/dev/null || true

for unit in streamdeck-ctl.service streamdeck-ctl-deck.service; do
    if [ -L "$unit_dir/default.target.wants/$unit" ]; then
        systemctl --user disable "$unit" >/dev/null 2>&1 || true
        if systemctl --user enable "$unit" >/dev/null 2>&1; then
            echo "  unit   $unit re-enabled under graphical-session.target"
        else
            echo "  unit   $unit is disabled; enable it with: systemctl --user enable $unit"
        fi
    fi
done

if [ ! -f "$udev_rule" ]; then
    echo
    echo "Stream Deck access needs a udev rule. Install it with:"
    echo "  sudo install -m 0644 $repo/src/streamdeck-ctl/udev/70-streamdeck-ctl.rules $udev_rule"
    echo "  sudo udevadm control --reload-rules && sudo udevadm trigger"
fi

if [ ! -f "$prompter_rule" ]; then
    echo
    echo "Elgato Prompter (optional) needs the AUR packages evdi-dkms and displaylink, then:"
    echo "  sed 's/@USER@/$USER/' $repo/src/prompter-ctl/udev/72-prompter-ctl.rules | sudo tee $prompter_rule >/dev/null"
    echo "  sudo udevadm control --reload && sudo systemctl restart displaylink"
fi

case ":$PATH:" in
    *":$bin_dir:"*) ;;
    *) echo "note: $bin_dir is not on PATH" ;;
esac

if [ "$with_preset" = 1 ] && [ "$first_install" = 1 ]; then
    echo
    echo "No Stream Deck configuration yet; applying the omarchy starter layout."
    "$bin_dir/streamdeck-ctl" deck preset omarchy --replace || true
fi

if [ "$with_skill" = 1 ]; then
    echo
    "$repo/scripts/install-skill"
fi

echo
echo "Enable the daemons with: streamdeck-ctl enable"
