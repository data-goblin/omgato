#!/usr/bin/env bash
# Reverse scripts/install. Device configuration is left alone: this removes what
# the plugin put on your system, not what you configured with it.
set -euo pipefail

repo="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
bin_dir="${XDG_BIN_HOME:-$HOME/.local/bin}"
unit_dir="${XDG_CONFIG_HOME:-$HOME/.config}/systemd/user"
state_dir="${XDG_STATE_HOME:-$HOME/.local/state}/omgato-panel"
cache_dir="${XDG_CACHE_HOME:-$HOME/.cache}/omgato-panel"
purge=0

[ "${1:-}" = "--purge" ] && purge=1

for unit in streamdeck-ctl.service streamdeck-ctl-deck.service; do
    systemctl --user disable --now "$unit" 2>/dev/null || true
    if [ -f "$unit_dir/$unit" ]; then
        rm -f "$unit_dir/$unit"
        echo "  unit     removed $unit"
    fi
done
systemctl --user daemon-reload 2>/dev/null || true

if [ -x "$bin_dir/omgato-panel" ]; then
    "$bin_dir/omgato-panel" uninstall-shortcuts 2>/dev/null || true
    echo "  hypr     shortcuts removed"
fi

"$repo/scripts/install-skill" --remove 2>/dev/null || true

for tool in camlink-ctl keylight-ctl omgato-panel streamdeck-ctl; do
    if [ -L "$bin_dir/$tool" ]; then
        rm -f "$bin_dir/$tool"
        echo "  bin      unlinked $tool"
    fi
done

rm -rf "$cache_dir"
echo "  cache    removed $cache_dir"

if [ "$purge" = 1 ]; then
    rm -rf "$state_dir"
    echo "  state    removed $state_dir (light names, order, undo history)"
else
    echo "  state    kept $state_dir; pass --purge to remove it"
fi

echo
echo "Left alone: your Stream Deck, camlink-ctl and Key Light configuration."
echo "The udev rule, if you installed it, is at /etc/udev/rules.d/70-streamdeck-ctl.rules"
