#!/usr/bin/env bash
set -euo pipefail

repo="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
name="omarchy-omgato"
legacy_name="omarchy-elgato"
source_dir="$repo/src/skill/omgato"
home_dir="${HOME:?HOME is required}"
remove=0

[ "${1:-}" = "--remove" ] && remove=1

targets=(
    "$home_dir/.agents/skills/$name"
    "$home_dir/.claude/skills/$name"
    "$home_dir/.codex/skills/$name"
    "$home_dir/.pi/agent/skills/$name"
    "$home_dir/.gemini/config/skills/$name"
)

touched=0
for target in "${targets[@]}"; do
    parent="$(dirname "$target")"
    legacy_target="$parent/$legacy_name"
    if [ -L "$legacy_target" ]; then
        rm -f "$legacy_target"
        echo "  removed  $legacy_target"
        touched=1
    fi
    if [ "$remove" = 1 ]; then
        [ -L "$target" ] && rm -f "$target" && echo "  removed  $target" && touched=1
        continue
    fi
    [ -d "$parent" ] || continue
    ln -sfn "$source_dir" "$target"
    echo "  linked   $target"
    touched=1
done

if [ "$touched" = 0 ] && [ "$remove" = 0 ]; then
    echo "  no agent skill directories found; nothing linked"
fi
